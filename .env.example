# Copy to .env and fill in. `python run.py doctor` checks every line below live.

# ---- model ------------------------------------------------------------------
# auto = first provider with a key, in this order: gemini, openai, anthropic.
LLM_PROVIDER=auto
GEMINI_API_KEY=
# extra Gemini keys, comma separated, rotated when one hits its daily cap
GEMINI_API_KEYS=
# any OpenAI-compatible endpoint: OpenAI, NVIDIA NIM, Groq, OpenRouter, Featherless
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# leave blank for per-provider defaults
#   gemini:    gemini-3.5-flash / gemini-3.5-flash-lite
#   openai:    gpt-5-mini / gpt-5-nano
#   anthropic: claude-opus-5 / claude-haiku-4-5
LLM_MODEL=
LLM_MODEL_CHEAP=
# Gemini only. 0 = thinking off (cheapest). Raise if drafts feel flat.
LLM_THINKING_BUDGET=0
# per-prospect research loop caps
LLM_MAX_STEPS=8
LLM_MAX_COST=0.05
# seconds between model calls; 6.5 keeps a free Gemini key under its per-minute
# limit. 0 once billing is on.
LLM_MIN_INTERVAL=6.5

# ---- telegram (the entire frontend) -----------------------------------------
# @BotFather -> token. Message the bot once, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates  (or run: python run.py doctor)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- research ---------------------------------------------------------------
# auto | tavily | brave | ddg | none   (auto = first provider with a key)
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=
MAX_FETCHES=4

# ---- quality ----------------------------------------------------------------
# hybrid | keyword | model | off   -- how claims are checked against sources
GROUNDING=hybrid
# run the AI-tell lint and one rewrite pass when it fails
HUMANIZE=1
# 1 = a draft that still fails the lint is queued flagged UNVERIFIED
HUMANIZE_STRICT=0

# ---- outbound mail ----------------------------------------------------------
# auto | gmail_api | smtp | manual
#   gmail_api: OAuth, sends from your Gmail, lands in Sent, threads replies.
#              Put the OAuth client JSON at data/gmail_credentials.json and run
#              `python run.py gmail-auth` once.
#   smtp:      Gmail app password (myaccount.google.com > Security > App passwords)
#   manual:    .eml + mailto link; nothing leaves the machine
MAIL_PROVIDER=auto
GMAIL_CREDENTIALS=data/gmail_credentials.json
GMAIL_TOKEN=data/gmail_token.json
# address to send as; blank = the authorised account
GMAIL_SENDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Even with this at 1, nothing is sent until you tap [Send] in Telegram.
# Set to 0 to force manual delivery for a while (e.g. while testing).
ALLOW_SEND=1

# Test-phase safety valve. While this lists addresses, [Send] only reaches
# those; every other recipient is held as an .eml and nothing goes out. Use
# it while you are testing from a personal account, then clear it.
#   SEND_ONLY_TO=you@gmail.com,someone.else@gmail.com
SEND_ONLY_TO=

# Sponsorship brochure, attached to the FIRST email and to any reply that
# answers a question -- not to the nudges, because re-sending the same PDF
# three times is how a thread starts looking like spam. Leave the file absent
# and the emails simply go out as plain text. Keep it under 15 MB.
BROCHURE=data/brochure.pdf

# ---- replies ----------------------------------------------------------------
# auto | gmail_api | imap | none   (auto = gmail_api when mail is gmail_api,
# else imap when configured)
REPLIES_PROVIDER=auto
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---- runtime ----------------------------------------------------------------
SPONSY_DB=data/sponsy.db
SPONSY_EVENT=data/event.yml
SPONSY_VOICE=data/voice.yml
